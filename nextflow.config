/*
========================================================================================
    CNV CALLING PIPELINE (ClinCNV WES)
========================================================================================
    Production pipeline configuration
    Converts SLURM-based ClinCNV pipeline to DSL2 Nextflow
----------------------------------------------------------------------------------------
*/

params {

    // =========================================================================
    // INPUT / OUTPUT
    // =========================================================================
    input                       = null          // samplesheet CSV: sample_id,bam,bai,sex
    outdir                      = './results'

    // =========================================================================
    // REFERENCE FILES
    // =========================================================================
    fasta                       = null          // hg38 FASTA
    fasta_fai                   = null          // hg38 FASTA index (.fai)  required by BedAnnotateGC
    cnv_bed                     = null          // CNV target BED with gene names in col 4
                                                    // comma-separated e.g. S000059_cexome6_hg38_cnvs_targets.bed
                                                    // DO NOT use SNV padded BED  padding dilutes coverage signal


    // =========================================================================
    // VCF HEADER
    // =========================================================================
    vcf_header                  = "${projectDir}/assets/header.vcf"

    // =========================================================================
    // INCREMENTAL COHORT  PERSISTENT COVERAGE STORE
    // =========================================================================
    //  First run:       set null  (no previous .cov files exist yet)
    //  Subsequent runs: NFS path where past .cov files live.
    //  Pipeline reads *.cov from here and merges with current batch.
    //  New .cov files are automatically archived here after BedCoverage.
    //  Must be on NFS (shared across nodes), NOT local scratch.
    //  Never point two simultaneous runs at the same previous_cov_dir.
    previous_cov_dir            = null

    // =========================================================================
    // CLINCNV PARAMETERS
    // =========================================================================
    // ⚑ Scale clincnv_memory/cpus as cohort grows:
    //    ~50  samples : 100 GB / 16 CPUs  (current)
    //    ~100 samples : 140 GB / 20 CPUs
    //    ~150 samples : 180 GB / 32 CPUs
    // Sex inference  always runs via SampleGender (xy method)
    // Samplesheet sex takes priority; inferred sex used only when sex=0 or missing
    // xy method: Y/X read ratio  most reliable for WES without variant calling

    // PED file for trio/duo aware CNV calling (optional)
    // null = singleton/cohort mode only
    // Provide PED when cohort contains trios or duos
    // Format: family_id, sample_id, father_id, mother_id, sex, phenotype
    //  Always add complete family units per batch  avoid split families across batches
    ped_file                    = null

    clincnv_score_threshold     = 60    // clinical grade analysis
    clincnv_min_length          = 0     // single-exon CNVs required for renal disease cohort
    clincnv_min_cluster         = 10    // 50 sample first batch; raise to 15 once cohort >100
    clincnv_max_germ_cnvs       = 2000
    clincnv_cpus                = 16
    clincnv_memory              = 100.GB

    // =========================================================================
    // VEP ANNOTATION (optional)
    // =========================================================================
    run_vep                     = false
    vep_cache                   = null          // /PATH/TO/resources/vep_cache
    vep_plugins                 = null          // /PATH/TO/resources/VEP_plugins
    sv_overlap_vcf              = null          // gnomAD-SV v4.1 VCF (tabix-indexed .tbi must exist alongside)
                                                    // /PATH/TO/sv_cache/gnomad.v4.1.sv.sites.vcf.gz

    // =========================================================================
    // R GENE PANEL FILTER (optional  requires run_vep = true)
    // =========================================================================
    run_rfilter                 = false
    gene_panel                  = null          // .xlsx with "Gene Symbol" column

    // =========================================================================
    // RESOURCE LIMITS
    // =========================================================================
    max_cpus                    = 38
    max_memory                  = 180.GB
    max_time                    = 168.h

    // =========================================================================
    // SLURM CONFIGURATION
    // =========================================================================
    slurm_account               = null
    slurm_partition             = 'ProdQ'
    slurm_queue_size            = 100

    // =========================================================================
    // PIPELINE OPTIONS
    // =========================================================================
    help                        = false
    publish_dir_mode            = 'copy'
}

// ── Container paths : change accrodingly ────────────────────────────────────────────────────────
params.singularity_image_dir = '/path/to/ONE4ALL/Docker_Images'

params.containers = [
    ngsbits:  "${params.singularity_image_dir}/ngsbits.sif",
    clincnv:  "${params.singularity_image_dir}/clincnv.sif",
    bcftools: "${params.singularity_image_dir}/bcftool_1.23.sif",
    vep:      "${params.singularity_image_dir}/vep.sif"
]

// Bind reference directory into all Singularity containers
// Required for BedAnnotateGC to access FASTA on NFS
singularity.runOptions = "-B /home/data -B /home/sdata"

profiles {
    slurm {
        process.executor = 'slurm'
        singularity.enabled    = true
        singularity.autoMounts = true
        singularity.cacheDir   = "${HOME}/.singularity/cache"
        docker.enabled         = false
        workDir                = "${params.outdir}/../work"
        includeConfig 'conf/slurm.config'
    }

    local {
        process.executor       = 'local'
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
    }

    test {
        includeConfig 'conf/test.config'
    }
}

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

// ── Execution reports ───────────────────────────────────────────────────────
def ts = new java.text.SimpleDateFormat('yyyyMMdd_HHmmss').format(new java.util.Date())

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/timeline_${ts}.html"
    overwrite = false
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/report_${ts}.html"
    overwrite = false
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/trace_${ts}.txt"
    overwrite = true
    fields  = 'task_id,hash,native_id,process,tag,name,status,exit,submit,start,complete,duration,realtime,%cpu,peak_rss,peak_vmem'
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/dag_${ts}.svg"
    overwrite = false
}

manifest {
    name            = 'cnv-calling-singletions'
    author          = 'Deepak Bharti'
    description     = 'ClinCNV WES germline CNV calling with optional VEP annotation and gene panel filtering'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=25.04.0'
    version         = '1.0.0'
}

def check_max(obj, type) {
    if (type == 'memory') {
        try {
            if (obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1)
                return params.max_memory as nextflow.util.MemoryUnit
            else return obj
        } catch (all) { println "WARNING: Invalid max_memory"; return obj }
    } else if (type == 'time') {
        try {
            if (obj.compareTo(params.max_time as nextflow.util.Duration) == 1)
                return params.max_time as nextflow.util.Duration
            else return obj
        } catch (all) { println "WARNING: Invalid max_time"; return obj }
    } else if (type == 'cpus') {
        try { return Math.min(obj, params.max_cpus as int) }
        catch (all) { println "WARNING: Invalid max_cpus"; return obj }
    }
}

cleanup = false   // keep work/ for -resume; set true only on confirmed successful runs
