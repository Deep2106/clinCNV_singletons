/*
========================================================================================
    test.config  Minimal test profile
    Use with: nextflow run main.nf -profile slurm,test
========================================================================================
*/

params {
    // Override resource limits to minimal for testing
    max_cpus   = 4
    max_memory = 16.GB
    max_time   = 2.h

    // Reduced ClinCNV thresholds for small test cohort
    clincnv_score_threshold   = 20
    clincnv_min_cluster       = 2
    clincnv_min_length        = 0
    clincnv_max_germ_cnvs     = 5000
    clincnv_cpus              = 4
    clincnv_memory            = 16.GB

    // Test data  replace with paths to your test BAMs
    // A minimum of 5 samples is required for ClinCNV to run at all
    input        = "${projectDir}/test/samplesheet_test.csv"
    fasta        = null   // ⚑ set to test reference FASTA
    fasta_fai    = null   // ⚑ set to test reference FASTA index
    cnv_bed      = null   // ⚑ set to CNV target BED with gene names in col 4

    // Disable optional steps for basic test
    run_vep      = false
    run_rfilter  = false

    previous_cov_dir = null   // always null for test runs

    outdir = './test_results'
}
